{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo run yt-tui",
      "type": "shell",
      "command": "cargo run --bin yt-tui",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo run yt-tui (release)",
      "type": "shell",
      "command": "cargo run --release --bin yt-tui",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo test",
      "type": "shell",
      "command": "cargo test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": ["$rustc"]
    }
  ]
}
